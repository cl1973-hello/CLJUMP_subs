{
  id: 99002,
  name: 'CLJUMP 自建规则',
  version: 1,
  author: 'cl1973-hello（含 667 规则，来源 Lin-arm/GKD_subscription）',
  supportUri: 'https://github.com/cl1973-hello/CLJUMP_subs/issues',
  apps: [
    {
      id: 'com.shuqi.controller',
      name: '书旗小说',
      groups: [
        {
          key: 20001,
          name: '阅读页广告',
          desc: '关闭正文中的内嵌广告及短剧推荐弹窗',
          enable: true,
          activityIds: ['com.shuqi.reader.ShuqiReaderActivity'],
          rules: [
            {
              key: 20001,
              name: '关闭内嵌广告',
              matches: '[vid="append_element_view_btn_container"]',
              action: 'clickNode',
              actionCd: 2000,
            },
            {
              key: 20002,
              name: '关闭短剧弹窗',
              matches: '[desc="关闭"][clickable=true]',
              action: 'clickNode',
              actionMaximum: 1,
              resetMatch: 'activity',
            },
            {
              key: 20003,
              name: '不再提示',
              matches: '[text="不再提示"]',
              action: 'clickNode',
              actionCd: 1000,
              actionMaximum: 1,
              resetMatch: 'activity',
            },
          ],
        },
      ],
    },
    {
      id: 'com.baidu.netdisk',
      name: '百度网盘',
      groups: [
        {
          key: 30001,
          name: '开屏广告',
          desc: '点击右上角跳过按钮',
          enable: true,
          activityIds: ['com.baidu.netdisk.ui.Navigate'],
          rules: [
            {
              key: 30001,
              name: '点击跳过',
              matches: '[text*="跳过"]',
              action: 'clickNode',
              actionCd: 500,
            },
          ],
        },
        {
          key: 30002,
          name: '摇一摇广告-强制返回',
          desc: '检测到摇一摇提示时按返回键，尝试直接关掉广告页',
          enable: false,
          activityIds: ['com.baidu.netdisk.ui.Navigate'],
          rules: [
            {
              key: 30002,
              name: '扭动手机提示时返回',
              matches: '[text*="扭动手机"]',
              action: 'back',
              actionCd: 3000,
              actionMaximum: 1,
              resetMatch: 'activity',
            },
          ],
        },
      ],
    },
    {
      id: 'com.whxinna.userplatform',
      name: '住理生活',
      groups: [
        {
          key: 40001,
          name: '开屏广告',
          desc: '无快照，按文案匹配，进入应用后 8 秒内有效',
          enable: true,
          matchTime: 8000,
          rules: [
            {
              key: 40001,
              name: '点击跳过',
              matches: '[text*="跳过"]',
              action: 'clickNode',
              actionCd: 500,
              actionMaximum: 5,
              resetMatch: 'activity',
            },
          ],
        },
        {
          key: 40002,
          name: '摇一摇广告-强制返回',
          desc: '检测到摇一摇提示时按返回键',
          enable: false,
          matchTime: 8000,
          rules: [
            {
              key: 40002,
              name: '扭动手机提示时返回',
              matches: '[text*="扭动手机"]',
              action: 'back',
              actionCd: 3000,
              actionMaximum: 1,
              resetMatch: 'activity',
            },
          ],
        },
      ],
    },
  ],
}
